# Copy to .env.local (never commit real secrets) and fill in.

# --- Public (safe for the browser) ---
VITE_SITE_URL=https://www.hoozeenterprises.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server only (NEVER prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email alert to you for every new lead (Resend). All three or none.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hooze Enterprises <notifications@your-verified-domain.com>
LEAD_NOTIFY_EMAIL=you@yourdomain.com
